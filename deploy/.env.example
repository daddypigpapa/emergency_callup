# See docs/SPEC.md §12.3. Copy to .env (or set these as real environment
# variables / systemd EnvironmentFile / Docker env) before starting the
# server. There is no default for any required value — a missing one
# refuses to start (docs/SPEC.md §11.1).

BASE_URL=https://mob.example.go.kr
LISTEN_ADDR=:8080
DATA_DIR=/data
TILE_URL=https://api.vworld.kr/req/wmts/1.0.0/{key}/Base/{z}/{y}/{x}.png
TILE_KEY=
TILE_ATTRIBUTION=VWorld
NAVER_APPNAME=mob.example.go.kr
NAVER_ROUTE_TYPE=car
# SMS: manual is always available. Fill in SMS_HTTP_URL to additionally
# enable the http provider (SPEC §9.1, §9.4).
SMS_HTTP_URL=
SMS_HTTP_AUTH_HEADER=
SMS_HTTP_BODY_TEMPLATE=
SMS_HTTP_RPS=10
SMS_SENDER=
FIX_RETENTION_DAYS=30
# Set to true only when a trusted reverse proxy (e.g. deploy/Caddyfile.example)
# sits directly in front of this server and sets X-Forwarded-For itself —
# otherwise a client could forge its own source IP and bypass rate limiting.
TRUST_PROXY=false
TLS_CERT_FILE=
TLS_KEY_FILE=
